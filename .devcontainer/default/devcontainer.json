{
  "name": "FIS (default)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/fis,type=bind",
  "workspaceFolder": "/workspaces/fis",
  "runArgs": [
    "--memory=8g",
    "--memory-swap=16g"
  ],
  "mounts": [
    {
      "source": "fis-data",
      "target": "/home/vscode/data",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "ruff.importStrategy": "fromEnvironment",
        "workbench.colorCustomizations": {
          "titleBar.activeBackground": "#004b7a",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#003b60",
          "titleBar.inactiveForeground": "#d0d0d0",
          "activityBar.background": "#002840",
          "activityBar.foreground": "#ffffff",
          "statusBar.background": "#002840",
          "statusBar.foreground": "#ffffff",
          "statusBarItem.remoteBackground": "#004b7a",
          "statusBarItem.remoteForeground": "#ffffff"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "forwardPorts": [
    8888,
    8787
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/data 2>/dev/null || true; uv sync --all-groups",
  "remoteUser": "vscode"
}
